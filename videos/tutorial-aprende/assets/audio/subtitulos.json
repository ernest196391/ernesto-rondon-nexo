[
 {
  "text": "¿Te perdiste algún video?",
  "start": 0.77,
  "end": 2.02
 },
 {
  "text": "Ahora están todos juntos en tu área,",
  "start": 2.03,
  "end": 3.8
 },
 {
  "text": "en: Aprende.",
  "start": 3.81,
  "end": 5.2
 },
 {
  "text": "Abre el menú, y toca: Aprende.",
  "start": 5.51,
  "end": 7.68
 },
 {
  "text": "Está debajo de Inicio,",
  "start": 7.69,
  "end": 8.6
 },
 {
  "text": "y te dice cuántos llevas.",
  "start": 8.61,
  "end": 10.42
 },
 {
  "text": "Ahí están los videos, en orden.",
  "start": 10.69,
  "end": 12.54
 },
 {
  "text": "El que dice: Te toca,",
  "start": 12.55,
  "end": 13.68
 },
 {
  "text": "es el siguiente.",
  "start": 13.69,
  "end": 14.98
 },
 {
  "text": "Toca el botón redondo,",
  "start": 14.99,
  "end": 16
 },
 {
  "text": "y el video se abre ahí mismo.",
  "start": 16.01,
  "end": 17.88
 },
 {
  "text": "No gasta datos hasta que lo tocas.",
  "start": 17.89,
  "end": 19.9
 },
 {
  "text": "Cuando terminas un video,",
  "start": 20.19,
  "end": 21.5
 },
 {
  "text": "se marca solo.",
  "start": 21.51,
  "end": 22.44
 },
 {
  "text": "Si no, toca: Marcar como visto.",
  "start": 22.45,
  "end": 24.94
 },
 {
  "text": "Cambia a: Ya lo vi,",
  "start": 24.95,
  "end": 26.26
 },
 {
  "text": "y sube tu avance.",
  "start": 26.27,
  "end": 27.73
 },
 {
  "text": "Abajo del todo están las dudas rápidas.",
  "start": 28.01,
  "end": 30.58
 },
 {
  "text": "Toca una, y te sale la respuesta.",
  "start": 30.59,
  "end": 32.52
 },
 {
  "text": "¿No está tu duda?",
  "start": 32.53,
  "end": 33.46
 },
 {
  "text": "Escríbele al asistente por WhatsApp.",
  "start": 33.47,
  "end": 35.33
 },
 {
  "text": "Mensajeros: ustedes la tienen abajo,",
  "start": 35.63,
  "end": 37.62
 },
 {
  "text": "en la pestaña Aprende.",
  "start": 37.63,
  "end": 39.15
 },
 {
  "text": "¿Dudas? Escríbeme.",
  "start": 41.83,
  "end": 43.46
 }
]