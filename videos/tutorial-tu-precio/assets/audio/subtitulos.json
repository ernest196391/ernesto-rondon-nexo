[
 {
  "text": "Tú decides tu precio.",
  "start": 0.47,
  "end": 2
 },
 {
  "text": "Lo que subas, es para ti.",
  "start": 2.01,
  "end": 4.02
 },
 {
  "text": "En tu área, toca: Mis precios.",
  "start": 4.15,
  "end": 6.7
 },
 {
  "text": "Para subirlos todos a la vez,",
  "start": 6.71,
  "end": 8.18
 },
 {
  "text": "pon un porcentaje en: Aumento general,",
  "start": 8.19,
  "end": 10.22
 },
 {
  "text": "y toca: Aplicar a mi tienda.",
  "start": 10.23,
  "end": 12.59
 },
 {
  "text": "Para un solo producto, abre:",
  "start": 12.73,
  "end": 14.1
 },
 {
  "text": "Ver y cambiar precios de un producto.",
  "start": 14.11,
  "end": 17.12
 },
 {
  "text": "Busca el producto, escribe tu precio,",
  "start": 17.13,
  "end": 18.54
 },
 {
  "text": "y toca: Guardar.",
  "start": 18.55,
  "end": 20.74
 },
 {
  "text": "Tus clientes ven tu precio",
  "start": 20.91,
  "end": 22.16
 },
 {
  "text": "solo cuando entran por tu enlace.",
  "start": 22.17,
  "end": 23.48
 },
 {
  "text": "En la tienda general, todos ven",
  "start": 23.49,
  "end": 25.44
 },
 {
  "text": "el precio de Casa Viva.",
  "start": 25.45,
  "end": 26.3
 },
 {
  "text": "Por ejemplo, este organizador",
  "start": 26.31,
  "end": 28.06
 },
 {
  "text": "sale a 30 dólares en la tienda,",
  "start": 28.07,
  "end": 29.68
 },
 {
  "text": "y a 35 con tu enlace.",
  "start": 29.69,
  "end": 32.24
 },
 {
  "text": "¿El pedido lo haces tú?",
  "start": 32.35,
  "end": 33.64
 },
 {
  "text": "Entra desde: Ver la tienda,",
  "start": 33.65,
  "end": 35
 },
 {
  "text": "o desde tu enlace,",
  "start": 35.01,
  "end": 35.9
 },
 {
  "text": "y añádelo al carrito ahí.",
  "start": 35.91,
  "end": 37.16
 },
 {
  "text": "Así sale a tu precio.",
  "start": 37.17,
  "end": 39.01
 },
 {
  "text": "Y si quitas tu aumento,",
  "start": 39.06,
  "end": 40.1
 },
 {
  "text": "tu cliente también deja de verlo:",
  "start": 40.11,
  "end": 40.78
 },
 {
  "text": "tu enlace enseña siempre",
  "start": 40.79,
  "end": 42.78
 },
 {
  "text": "el precio que tienes guardado.",
  "start": 42.79,
  "end": 44.43
 },
 {
  "text": "¿Dudas? Escríbeme.",
  "start": 44.63,
  "end": 46.19
 }
]