[
 {
  "text": "¿Tu cliente te pide algo",
  "start": 0.25,
  "end": 1.2
 },
 {
  "text": "que no tenemos en Casa Viva?",
  "start": 1.21,
  "end": 3
 },
 {
  "text": "Hoy mismo nos lo pidieron.",
  "start": 3.2,
  "end": 5.01
 },
 {
  "text": "Dayami: muchos clientes me piden",
  "start": 5.02,
  "end": 7.03
 },
 {
  "text": "cortinas de baño con teflón.",
  "start": 7.04,
  "end": 9.41
 },
 {
  "text": "Nadielys: ¿de casualidad sabes",
  "start": 9.42,
  "end": 11.55
 },
 {
  "text": "dónde hay estos ventiladores?",
  "start": 11.56,
  "end": 13.35
 },
 {
  "text": "Un cliente en Calabazar quiere 2.",
  "start": 13.36,
  "end": 15.25
 },
 {
  "text": "Las escuchamos.",
  "start": 15.26,
  "end": 16.5
 },
 {
  "text": "Ahora lo puedes vender.",
  "start": 16.7,
  "end": 17.95
 },
 {
  "text": "Con NEXO Busca, subes una foto,",
  "start": 17.96,
  "end": 19.41
 },
 {
  "text": "y te decimos quién lo vende en Cuba,",
  "start": 19.42,
  "end": 20.95
 },
 {
  "text": "y a qué precio.",
  "start": 20.96,
  "end": 22.1
 },
 {
  "text": "Está en tu área.",
  "start": 22.2,
  "end": 23.11
 },
 {
  "text": "Abre el menú, y en Herramientas,",
  "start": 23.12,
  "end": 24.67
 },
 {
  "text": "toca: NEXO Busca.",
  "start": 24.68,
  "end": 26.81
 },
 {
  "text": "Sube la foto que te mandó el cliente,",
  "start": 26.95,
  "end": 28.58
 },
 {
  "text": "o escribe qué buscas.",
  "start": 28.59,
  "end": 30.26
 },
 {
  "text": "Y toca: Buscar quién lo vende.",
  "start": 30.27,
  "end": 32.59
 },
 {
  "text": "En segundos salen los vendedores,",
  "start": 32.69,
  "end": 34
 },
 {
  "text": "con su precio.",
  "start": 34.01,
  "end": 34.96
 },
 {
  "text": "Elige uno, y toca: Usar esta.",
  "start": 34.97,
  "end": 37.14
 },
 {
  "text": "Ahora define tu precio:",
  "start": 37.24,
  "end": 38.55
 },
 {
  "text": "sumar dólares, sumar un porcentaje,",
  "start": 38.56,
  "end": 40.41
 },
 {
  "text": "o el precio final.",
  "start": 40.42,
  "end": 41.81
 },
 {
  "text": "Por ejemplo: el proveedor pide 10,",
  "start": 41.82,
  "end": 43.77
 },
 {
  "text": "tú pides 12, y ganas 2 dólares.",
  "start": 43.78,
  "end": 46.23
 },
 {
  "text": "Pregúntale al proveedor por WhatsApp",
  "start": 46.36,
  "end": 47.65
 },
 {
  "text": "si lo tiene.",
  "start": 47.66,
  "end": 48.47
 },
 {
  "text": "Hazle una foto bonita",
  "start": 48.48,
  "end": 49.33
 },
 {
  "text": "en tu estudio de fotos.",
  "start": 49.34,
  "end": 50.71
 },
 {
  "text": "Y mándasela a tu cliente,",
  "start": 50.72,
  "end": 51.95
 },
 {
  "text": "sin decir dónde lo compras.",
  "start": 51.96,
  "end": 54.1
 },
 {
  "text": "¿Prefieres venderlo por Casa Viva?",
  "start": 54.26,
  "end": 56.25
 },
 {
  "text": "Manda la solicitud.",
  "start": 56.26,
  "end": 57.59
 },
 {
  "text": "Casa Viva lo confirma con el proveedor,",
  "start": 57.6,
  "end": 59.23
 },
 {
  "text": "y te avisa por WhatsApp con tu comisión.",
  "start": 59.24,
  "end": 61.94
 },
 {
  "text": "20 búsquedas al día, gratis.",
  "start": 62.26,
  "end": 63.73
 },
 {
  "text": "¿Dudas? Escríbeme.",
  "start": 63.74,
  "end": 64.98
 }
]