[
 {
  "text": "Esta semana casi perdemos",
  "start": 0.25,
  "end": 1.58
 },
 {
  "text": "una bicicleta eléctrica de 550 dólares.",
  "start": 1.59,
  "end": 4.44
 },
 {
  "text": "La clienta escribía desde un número",
  "start": 4.64,
  "end": 6.37
 },
 {
  "text": "y llamaba desde otro.",
  "start": 6.38,
  "end": 7.87
 },
 {
  "text": "Cary la buscó en Facebook",
  "start": 7.88,
  "end": 9.11
 },
 {
  "text": "y ya estaba reportada como estafadora.",
  "start": 9.12,
  "end": 11.96
 },
 {
  "text": "Y hoy, Niurka nos avisó de otra trampa.",
  "start": 12.16,
  "end": 14.69
 },
 {
  "text": "Una pareja, con el mismo número,",
  "start": 14.7,
  "end": 16.31
 },
 {
  "text": "pide un artículo",
  "start": 16.32,
  "end": 16.97
 },
 {
  "text": "y da una dirección falsa.",
  "start": 16.98,
  "end": 18.91
 },
 {
  "text": "Espera al mensajero en la calle.",
  "start": 18.92,
  "end": 20.59
 },
 {
  "text": "Paga con un billete falso de 100 dólares.",
  "start": 20.6,
  "end": 22.59
 },
 {
  "text": "Y desaparece.",
  "start": 22.6,
  "end": 23.68
 },
 {
  "text": "El que pierde es el que recibe el billete.",
  "start": 24.08,
  "end": 25.99
 },
 {
  "text": "Por eso hicimos Billete Seguro.",
  "start": 26,
  "end": 27.78
 },
 {
  "text": "Eliges el billete",
  "start": 28.16,
  "end": 29.05
 },
 {
  "text": "y haces cuatro pruebas,",
  "start": 29.06,
  "end": 30.73
 },
 {
  "text": "a contraluz, inclinándolo,",
  "start": 30.74,
  "end": 32.67
 },
 {
  "text": "tocándolo y con luz ultravioleta.",
  "start": 32.68,
  "end": 34.75
 },
 {
  "text": "Al final, pones el número de serie.",
  "start": 34.76,
  "end": 37.07
 },
 {
  "text": "En un minuto te dice,",
  "start": 37.27,
  "end": 38.41
 },
 {
  "text": "sin señales de falso,",
  "start": 38.42,
  "end": 39.67
 },
 {
  "text": "dudoso o no lo aceptes.",
  "start": 39.68,
  "end": 41.45
 },
 {
  "text": "Si sale rojo, lo devuelves con calma",
  "start": 41.46,
  "end": 43.17
 },
 {
  "text": "y avisas al equipo.",
  "start": 43.18,
  "end": 44.61
 },
 {
  "text": "Úsala siempre que te paguen",
  "start": 45.01,
  "end": 46.14
 },
 {
  "text": "con un billete grande,",
  "start": 46.15,
  "end": 47.32
 },
 {
  "text": "100 dólares o 5 mil, 10 mil o 20 mil pesos,",
  "start": 47.33,
  "end": 51.1
 },
 {
  "text": "sobre todo con clientes nuevos",
  "start": 51.11,
  "end": 52.44
 },
 {
  "text": "y en las entregas en la calle.",
  "start": 52.45,
  "end": 54.57
 },
 {
  "text": "Está en casaviva.company/billete",
  "start": 54.89,
  "end": 57.82
 },
 {
  "text": "Guarda el enlace hoy,",
  "start": 57.83,
  "end": 58.86
 },
 {
  "text": "antes de tu próxima entrega.",
  "start": 58.87,
  "end": 60.81
 }
]