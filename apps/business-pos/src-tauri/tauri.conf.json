{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXO Business",
  "version": "0.0.1",
  "identifier": "com.nexo.business",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm.cmd run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NEXO Business",
        "width": 1024,
        "height": 720,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:nexo-business.db"]
    }
  }
}
